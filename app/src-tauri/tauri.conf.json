{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "R Light Control",
  "version": "0.1.0",
  "identifier": "com.rlightcontrol.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter ui dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter ui generate",
    "frontendDist": "../../ui/.output/public"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
